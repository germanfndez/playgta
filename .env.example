# Copy to .env for non-secret settings. Put secrets (tokens, keys) in
# ~/Library/Application Support/playgta/server.env (mode 600) on the host instead.
# Every variable is optional; see docs/configuration.md. Values below are placeholders.

# --- Server ---
HOST=127.0.0.1
PORT=3000
# The public address (OAuth redirect, WebSocket origin check, HSTS).
# PUBLIC_URL=https://play.example.com
# What proxies to the server: none, or cloudflare (a Cloudflare Tunnel).
# TRUSTED_PROXY=none

# --- Player page ---
# KEYBOARD_LAYOUT=gta          # or generic (keys name console buttons, for any game)

# --- Turns ---
TURN_MINUTES=10
EXTENSION_MINUTES=5
IDLE_TURN_SECONDS=20
# BLOCKED_BUTTONS=ps,create

# --- Console and video ---
# CONSOLE=simulated            # or chiaki
# CONSOLE_HOST=192.0.2.10      # the console's LAN IP address (never offered as an ICE candidate)
# CHIAKI_NICKNAME=MyConsole    # as registered in chiaki-ng
# VIDEO=off                    # or webrtc
# VIDEO_MAX_SPECTATORS=5

# --- Persistence ---
# STATE_FILE=state/state.json  # "off" disables it

# --- Admin API (local only, `bun run admin`) ---
# ADMIN_TOKEN=replace-with-a-long-random-string

# --- Log in with Kick ---
# KICK_CLIENT_ID=your-client-id
# KICK_CLIENT_SECRET=your-client-secret
# KICK_CHANNEL=your-channel

# --- Paused mode ---
# PAUSED=off

# --- Restream (deploy/macos/run-kick.sh; keep the key in kick.env) ---
# KICK_STREAM_URL=rtmps://ingest.example.com/app
# KICK_STREAM_KEY=your-stream-key
# OVERLAY_TITLE=Viewers play

# --- Tunnel (deploy/macos/run-tunnel.sh; keep the token in tunnel.env) ---
# CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token
